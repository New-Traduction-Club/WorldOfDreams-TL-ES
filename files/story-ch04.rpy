    # mc "I'll show you later. It's an older one of mine."
    mc "Te lo enseño luego. Es uno de los míos más antiguos."

# game/story.rpy:4209
translate spanish story_f8b646bf:

    # cm "{i}Oh, okay.{/i}"
    cm "{i}Ah.{/i}"

