    # cm "{i}You sounded so confident earlier, though.{/i}"
    cm "{i}Aunque antes sonabas muy seguro.{/i}"

# game/story.rpy:4231
translate spanish story_1fe5ec48:

    # mc "I didn't want you to worry."
    mc "No quería que te preocuparas."

# game/story.rpy:4232
