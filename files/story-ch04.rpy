
# game/story.rpy:3239
translate spanish story_2bbda894:

    # mc "{b}Meiji, be mindful. Let them make the first move.{/b}"
    mc "{b}Meiji, vigila. Deja que den el primer paso.{/b}"

# game/story.rpy:3240
translate spanish story_b35b8622:

    # mc "So you brought them here instead?"
    mc "¿Así que las has traído tú aquí?"

# game/story.rpy:3242
translate spanish story_46fd6ac1:

    # s "Are...are you mad at me?"
    s "¿Estás... estás enfadado conmigo?"

# game/story.rpy:3244
translate spanish story_fccb12eb:

    # "I sigh, rub my eyes a bit then look up at her with a smile."
    "Suspiro, me froto los ojos un poco y luego la miro con una sonrisa."

# game/story.rpy:3245
translate spanish story_3a4a37f2:

    # mc "No...I'm not mad at you. You're my bestest friend. Even if I was, I couldn't stay upset for long."
    mc "No... no estoy enfadado contigo. Eres mi mejor amiga. Aunque lo estuviera, no me cabrearía por mucho tiempo."

# game/story.rpy:3247
translate spanish story_247ccf9e:

    # y "Ah, are we bothering you?"
    y "Ah, ¿te estamos estorbando?"

# game/story.rpy:3249
translate spanish story_70eddb84:

    # mc "No, it's alright."
    mc "No, no pasa nada."

# game/story.rpy:3250
translate spanish story_22ddff9b:

    # "I slowly sit up."
    "Me incorporo poco a poco."

# game/story.rpy:3251
translate spanish story_cf824727:

    # mc "Um, it's a pleasure to meet you all. I'm Chizu Meiji, Sayori's neighbor and best friend."
    mc "Mmm, un placer conocer a todas. Soy Chizu Meiji, el vecino y mejor amigo de Sayori."

# game/story.rpy:3254
translate spanish story_a4dcadb1:

    # y "It's a pleasure to meet you. Sayori's telling us nothing but good things about you during club meetings."
    y "Un placer conocerte. Sayori no nos dice sino cosas buenas de ti en las reuniones del club."

# game/story.rpy:3257
translate spanish story_541512e1:

    # n "Seriously, Sayori? This sick boy is who you choose? So much for a nice club atmosphere..."
    n "¿En serio, Sayori? ¿Este chico enfermo es a quien eliges? Nada de ambiente agradable para el club..."

# game/story.rpy:3259
translate spanish story_01263f10:

    # cm "{i}You didn't tell me the other girls were this cute, dude! I mean wow!{/i}"
    cm "{i}¡No me dijiste que las otras chicas fueran tan monas, tío! ¡O sea, vaya!{/i}"

# game/story.rpy:3260
translate spanish story_711627b9:

    # mc "{b}Huh, that's strange...{/b}"
    mc "{b}Eh, eso es raro...{/b}"

# game/story.rpy:3261
translate spanish story_6972d6de:

    # cm "{i}What is it? The fact that these incredibly cute girls showed up to my house?{/i}"
    cm "{i}¿Qué es? ¿El hecho de que estas chicas increíblemente monas hayan aparecido en mi casa?{/i}"

# game/story.rpy:3262
translate spanish story_d3f3de25:

    # mc "{b}Well that too, but I meant this conversation. It's nearly identical to the way it goes in the original game.{/b}"
    mc "{b}Eso también, pero me refería a esta conversación. Es casi idéntica a como va en el juego original.{/b}"

# game/story.rpy:3263
translate spanish story_3e744568:

    # mc "{b}Alright, let's see how it goes.{/b}"
    mc "{b}Vale, a ver cómo va.{/b}"

# game/story.rpy:3264
translate spanish story_e67619e9:

    # "I don't add on that Meiji's following the script a bit too."
    "No añado que Meiji también sigue el guion un poco."

# game/story.rpy:3265
translate spanish story_367108cc:

    # "Better keep an eye on that."
    "Conviene vigilarlo."

# game/story.rpy:3267
translate spanish story_50a3834f:

    # s "You can just ignore her when she gets moody~"
    s "Puedes ignorarla cuando se ponga malhumorada..."

# game/story.rpy:3269
translate spanish story_f4b3e5d1:

    # "Sayori says that quietly into my ear, then turns back toward the other girls."
    "Sayori me lo susurra al oído y luego vuelve la cabeza hacia las otras chicas."

# game/story.rpy:3271
translate spanish story_74b1f87b:

    # s 1x "Anyway! This is Muramoto Natsuki from class 3-C, always full of energy."
    s 1x "¡En fin! Esta es Muramoto Natsuki, de la clase 2-C, siempre llena de energía."

# game/story.rpy:3272
translate spanish story_3a4f1af8:

    # s "And this is Yoshika Yuri from class 3-E, the smartest in the club!"
    s "¡Y esta es Yoshika Yuri, de la clase 2-E, la más lista del club!"

# game/story.rpy:3275
translate spanish story_084001f0:

    # y 4b "D-Don't say things like that..."
    y 4b "No, n-no digas cosas así..."

# game/story.rpy:3277
translate spanish story_4f108e78:

    # cm "{i}Hmm...{/i}"
    cm "{i}Mmm...{/i}"

# game/story.rpy:3278
translate spanish story_8d5b7272:

    # mc "{b}What is it?{/b}"
    mc "{b}¿Qué es?{/b}"

# game/story.rpy:3279
translate spanish story_19df0fbc:

    # cm "{i}Maybe it's just me, but Yoshika-san kind of seems like the type who has a hard time keeping up with people like Sayori and Muramoto-san.{/i}"
    cm "{i}Quizás sea cosa mía, pero a Yoshika-san le cuesta seguir el ritmo de gente como Sayori y Muramoto-san.{/i}"

# game/story.rpy:3280
translate spanish story_9bc7618a:

    # mc "{b}She does, but don't think any less of her.{/b}"
    mc "{b}Le cuesta, pero no pienses menos de ella por eso.{/b}"

# game/story.rpy:3281
translate spanish story_6aa714d5:

    # mc "{b}She's extremely intelligent and we're going to need her help to see if we can let you take control for a bit.{/b}"
    mc "{b}Es extremadamente inteligente y vamos a necesitar su ayuda para ver si podemos dejarte tomar el control un rato.{/b}"

# game/story.rpy:3283
translate spanish story_61efb047:

    # s 2q "And you already know our club President Asano Monika from class 3-D, right?"
    s 2q "Ya conoces a la presidenta de nuestro club, Asano Monika, de la clase 2-D, ¿no?"

# game/story.rpy:3285
translate spanish story_ca878818:

    # "3-D? Really? OF course she has that classroom..."
    "¿2-D? ¿En serio? Por supuesto que tiene esa aula..."

# game/story.rpy:3287
translate spanish story_05c2fa03:

    # m "Ahaha, yes, nice to see you again, Chizu-san. Sorry again about the head."
    m "Ja, ja, ja, sí, qué gusto verte otra vez, Chizu-san. Perdóname otra vez por lo de la cabeza."

# game/story.rpy:3288
translate spanish story_f88805bb:

    # m 11g "Are you okay? Does it hurt still?"
    m 11g "¿Estás bien? ¿Sigue doliendo?"

# game/story.rpy:3290
translate spanish story_79784ae7:

    # "Well, that's new."
    "Bueno, eso es nuevo."

# game/story.rpy:3291
translate spanish story_70af503d:

    # mc "No, it's not hurting as bad as before and don't be sorry. It wasn't your fault."
    mc "No, no duele tanto como antes, y no te disculpes. No fue tu culpa."

# game/story.rpy:3293
translate spanish story_b4522fbb:

    # "I smile back at her. My heart's really going doki-doki right now. She really is very beautiful."
    "Le devuelvo la sonrisa. Mi corazón va a mil ahora mismo. De verdad que es muy guapa."

# game/story.rpy:3296
translate spanish story_70ca2017:

    # n "Wait, you guys know each other?"
    n "Espera, ¿os conocéis?"

# game/story.rpy:3298
translate spanish story_37ec85c9:

    # mc "We were in the same class last year, but we didn't really talk. Like ever, right?"
    mc "Estuvimos en la misma clase el año pasado, pero no nos hablamos. Algo tan frecuente como... nunca."

# game/story.rpy:3300
translate spanish story_0f779307:

    # m "Ahaha, hardly ever."
    m "Ja, ja, ja, eso mismo."

# game/story.rpy:3303
translate spanish story_8c8ef632:

    # s "Well, we're going to have to fix that."
    s "Bueno, tendremos que arreglar eso."

# game/story.rpy:3305
translate spanish story_7d760f7f:

    # s 3h "Um, Meiji, do you feel well enough to have some cupcakes?"
    s 3h "Mmm, Meiji, ¿te sientes lo bastante bien como para comer unos cupcakes?"

# game/story.rpy:3307
translate spanish story_e2f8edc0:

    # mc "Cupcakes?"
    mc "¿Cupcakes?"

# game/story.rpy:3308
translate spanish story_fcc82e89:

    # "I put a hand on my stomach, taking a deep breath."
    "Me pongo la mano en el estómago y respiro hondo."

# game/story.rpy:3309
translate spanish story_47819023:

    # mc "You know, I do feel better than before. A cupcake does sound good."
    mc "Oye, de verdad que me siento mejor que antes. Un cupcake suena bien."

# game/story.rpy:3310
translate spanish story_1356c536:

    # mc "I've only had chicken broth today."
    mc "Hoy solo he tomado caldo de pollo."

# game/story.rpy:3312
translate spanish story_e3f1a2c5:

    # s "I'll get them~"
    s "¡Voy por ellos...!"

# game/story.rpy:3315
translate spanish story_7dba2d0b:

    # n "Hey! I made them, I'll get them!"
    n "¡Oye! Yo los he hecho, yo voy por ellos!"

# game/story.rpy:3318
translate spanish story_0d2a5328:

    # s 5a "Sorry, I got a little too excited~"
    s 5a "Perdona, me he emocionado un poco de más..."

# game/story.rpy:3325
translate spanish story_e880ad18:

    # "Natsuki and Sayori head to the kitchen, Sayori practically giddy with excitement."
    "Natsuki y Sayori van a la cocina, esta última prácticamente loca de emoción."

# game/story.rpy:3327
translate spanish story_965280f9:

    # y 3t "Um, Chizu-san? Is it okay if I make some tea as well? It might help you feel better."
    y 3t "Mmm, Chizu-san? ¿Puedo preparar un poco de té también? Quizás te ayude a sentirte mejor."

# game/story.rpy:3328
translate spanish story_787e0624:

    # y 3v "Assuming you have some kind of tea set?"
    y 3v "Suponiendo que tengáis algún juego de té..."

# game/story.rpy:3330
translate spanish story_a4d91e3f:

    # mc "{b}Do you guys have a tea set?{/b}"
    mc "{b}¿Tenéis un juego de té?{/b}"

# game/story.rpy:3331
translate spanish story_ec475e91:

    # cm "{i}Sayori knows where all the tea stuff is. We haven't moved it since she was last here.{/i}"
    cm "{i}Sayori sabe dónde está todo lo del té. No lo hemos movido desde la última vez que estuvo aquí.{/i}"

# game/story.rpy:3332
translate spanish story_fe924c49:

    # mc "Oh, of course you can. Sayori knows where our tea set is."
    mc "Ah, claro que sí. Sayori sabe dónde está nuestro juego de té."

# game/story.rpy:3334
translate spanish story_be4f237c:

    # y "Thank you, Chizu-san."
    y "Gracias, Chizu-san."

# game/story.rpy:3338
translate spanish story_5cc72b8b:

    # "Welp, alone with Monika."
    "Pues ya, a solas con Monika."

# game/story.rpy:3339
translate spanish story_bf11cabe:

    # "What should I ask her?"
    "¿Qué le pregunto?"

# game/story.rpy:3340
translate spanish story_11bedf1c:

    # "Hmm..."
    "Mmm..."

# game/story.rpy:3341
translate spanish story_84a5c89b:

    # "I've got it!"
    "¡Ya sé!"

# game/story.rpy:3343
translate spanish story_8de75786:

    # mc "So, Asano-san, I'm curious. How come you decided to make a new club? You're pretty talented already."
    mc "Oye, Asano-san, tengo curiosidad. ¿Por qué decidiste crear un club nuevo? Ya eres bastante talentosa."

# game/story.rpy:3344
translate spanish story_f4f5953e:

    # mc "You could be a high-ranking member of any of the major clubs at school. Weren't you pretty high up in the Debate Club last year?"
    mc "Podrías ser una miembro de alto rango en cualquiera de los grandes clubes del instituto. ¿No estabas bastante arriba en el Club de Debate el año pasado?"

# game/story.rpy:3345
translate spanish story_ae037c52:

    # "Monika sits a respectful distance away on the other couch."
    "Monika se sienta a una distancia respetuosa en el otro sofá."

# game/story.rpy:3346
translate spanish story_10507774:

    # m 6d "Well...if I'm honest, I hate big club politics."
    m 6d "Bueno... si te soy sincera, odio la política de los grandes clubes."

# game/story.rpy:3347
translate spanish story_4b62eec1:

    # "She picks up {i}Portrait of Markov{/i} and looks over it nonchalantly."
    "Coge {i}El retrato de Markov{/i} y lo hojea con despreocupación."

# game/story.rpy:3348
translate spanish story_0585d2e4:

    # m 8r "While I was in that club, there was nothing but arguments on budgets, publicity and preparing for events."
    m 8r "Mientras estaba en ese club, no había nada más que discusiones sobre presupuestos, publicidad y preparación de eventos."

# game/story.rpy:3349
translate spanish story_95e877ae:

    # m 8n "Don't get me wrong, the debating part of the club was fine and all..."
    m 8n "No me malinterpretes, la parte de debate del club estaba bien y todo..."

# game/story.rpy:3350
translate spanish story_7ee138bc:

    # m 8p "But I wanted to form something based around something I enjoy and try and make something special out of it as well."
    m 8p "Pero quería crear algo basado en algo que disfrute e intentar hacer de ello algo especial."

# game/story.rpy:3351
translate spanish story_1510ea97:

    # m 1b "And if that encourages people to get into literature, then I'm already making that dream into {i}reality{/i}!"
    m 1b "Y si eso anima a la gente a interesarse por la literatura, ¡entonces ya estoy convirtiendo ese sueño en realidad!"

# game/story.rpy:3353
translate spanish story_150396a9:

    # "Subtle, Monika. Really subtle."
    "Sutil, Monika. Muy sutil."

# game/story.rpy:3354
translate spanish story_b1ee7f0a:

    # mc "{b}Seems like she knows already.{/b}"
    mc "{b}Parece que ya lo sabe.{/b}"

# game/story.rpy:3355
translate spanish story_12730da8:

    # cm "{i}I'm just going to have to keep taking your word for this, aren't I?{/i}"
    cm "{i}Tendré que seguir creyéndote, ¿verdad?{/i}"

# game/story.rpy:3356
translate spanish story_a37a7005:

    # mc "{b}Yep.{/b}"
    mc "{b}Sip.{/b}"

# game/story.rpy:3357
translate spanish story_8d1b033b:

    # mc "Well, that's certainly an admirable goal."
    mc "Bueno, eso es sin duda un objetivo admirable."

# game/story.rpy:3358
translate spanish story_0b88f895:

    # mc "Sayori said you're a great leader and, from what I've heard of you and remember about you from last year, I believe it."
    mc "Sayori dijo que eres una gran líder y, por lo que he oído de ti y lo que recuerdo de ti del año pasado, se lo creo."

# game/story.rpy:3360
translate spanish story_0965e402:

    # mc "But how come your club doesn't have more members?"
    mc "Pero, ¿por qué no tiene más miembros tu club?"

# game/story.rpy:3361
translate spanish story_7725e343:

    # mc "I mean, I get you're still kinda new, but I'd have thought there were more people in our school into literature than just the four of you."
    mc "O sea, entiendo que sois más o menos nuevas, pero pensaría que habría más gente en nuestro instituto interesada en la literatura que solo las cuatro."

# game/story.rpy:3362
translate spanish story_f4ca4721:

    # m 4zzj "Well, you have to understand, not many people are willing to put in the effort to start something brand new."
    m 4zzj "Bueno, tienes que entender que no mucha gente está dispuesta a esforzarse en empezar algo completamente nuevo."

# game/story.rpy:3363
translate spanish story_dd5b3371:

    # m 4k "Especially with something that doesn't grab your attention like literature."
    m 4k "Especialmente con algo que no atrae la atención, como la literatura, por ejemplo."

# game/story.rpy:3364
translate spanish story_3ed4d9dd:

    # m 1b "It's a lot of work trying to convince people that you're fun and worthwhile."
    m 1b "Es mucho trabajo intentar convencer a la gente de que es divertido y que merece la pena."

# game/story.rpy:3365
translate spanish story_e0d31a4d:

    # m "But that just makes school events, like the Culture Festival, that much more important. I'm hopeful that we can grow this club before we graduate."
    m "Pero eso hace que los eventos del instituto, como el Festival Cultural, sean aún más importantes. Espero poder hacer crecer este club antes de graduarnos."

# game/story.rpy:3367
translate spanish story_8497030e:

    # mc "Admirable, and I hope that dream gets realized."
    mc "Admirable, y espero que ese sueño se haga realidad."

# game/story.rpy:3368
translate spanish story_37f1a479:

    # "Just then Natsuki walks back in, tray in hand."
    "Justo entonces Natsuki vuelve a entrar, con la bandeja en la mano."

# game/story.rpy:3372
translate spanish story_5be7519f:

    # n "Okaaay, are you ready?"
    n "Vaaale, ¿estáis listos?"

# game/story.rpy:3373
translate spanish story_0e979e8a:

    # mc "You've no idea."
    mc "Vamos a darle."

# game/story.rpy:3374
translate spanish story_16925a74:

    # "I give Monika a sideways glance."
    "Lanzo una mirada de reojo a Monika."

# game/story.rpy:3376
translate spanish story_638723ff:

    # "I can almost see a flirtatious rising of her shoulder."
    "Casi puedo ver cómo se le sube un hombro con coquetería."

# game/story.rpy:3378
translate spanish story_a49f0dc7:

    # n "...Ta-daa!"
    n "¡Ta-dá!"

# game/story.rpy:3379
translate spanish story_65c7972e:

    # s 4m "Uwooooah!"
    s 4m "¡Halaaa!"

# game/story.rpy:3380
translate spanish story_2ab3d8aa:

    # "Natsuki lifts the foil off the tray."
    "Natsuki levanta el papel de aluminio de la bandeja."

# game/story.rpy:3381
translate spanish story_9a86397d:

    # "I hadn't seen the cupcakes in the game. They were described as cats, but the craftsmanship I see is beyond anything any normal high school senior can make."
    "No había visto los cupcakes en el juego. Estaban descritos como gatos, pero la destreza que veo va más allá de lo que cualquier alumna corriente de segundo de bachillerato pueda hacer."

# game/story.rpy:3382
translate spanish story_3fa79be2:

    # "The cupcakes themselves are soft and white, with the multicolored frosting having been poured on expertly."
    "Los cupcakes en sí son suaves y blancos, con la crema de colores vertida con maestría."

# game/story.rpy:3383
translate spanish story_ecb59c27:

    # "The image of cute kittens were probably painted on with some sort of brush made for that purpose."
    "La imagen de los gatitos monos probablemente estuviera pintada con algún tipo de pincel hecho para ese fin."

# game/story.rpy:3384
translate spanish story_a6dbadfd:

    # "The whiskers are made of chocolate icing and bits of chocolate sprinkles make up the ears."
    "Los bigotes están hechos con chocolate y trocitos de virutas forman las orejas."

# game/story.rpy:3386
translate spanish story_697c694e:

    # s 4r "So cuuuute~!"
    s 4r "¡Qué moniiitos...!"

# game/story.rpy:3389
translate spanish story_1100f38d:

    # m 2b "I had no idea you were {i}this{/i} good at baking, Natsuki!"
    m 2b "¡No tenía ni idea de que eras tan buena horneando, Natsuki!"

# game/story.rpy:3392
translate spanish story_ab028ca4:

    # n 2d "Ehehe. Well, you know."
    n 2d "Je, je. Bueno, ya sabes."

# game/story.rpy:3393
translate spanish story_e6b842e2:

    # n "Just hurry up and take one. I didn't make them to be stared at all day!"
    n "¡Date prisa y coge uno! ¡No los hice para mirarlos!"

# game/story.rpy:3395
translate spanish story_1489ea28:

    # "Sayori grabs one first and immediately inhales it."
    "Sayori coge uno primero y se lo lleva a la boca."

# game/story.rpy:3397
translate spanish story_c93c611d:

    # s 4q "Shooo gooood!"
    s 4q "¡Qué riiico!"

# game/story.rpy:3403
translate spanish story_44718da6:

    # "I grab one, then look over at Natsuki who's sneaking glances in my direction."
    "Cojo uno y luego miro a Natsuki, que me está lanzando miradas furtivas."

# game/story.rpy:3404
translate spanish story_47a8bdf7:

    # cm "{i}Is she waiting for us to take a bite?{/i}"
    cm "{i}¿Está esperando a que demos un bocado?{/i}"

# game/story.rpy:3405
translate spanish story_33ddba6d:

    # mc "{b}Yeah, she is.{/b}"
    mc "{b}Sí, lo está.{/b}"

# game/story.rpy:3406
translate spanish story_0975e2fc:

    # "I make a show of looking over the cupcake."
    "Hago como que examino el cupcake a fondo."

# game/story.rpy:3407
translate spanish story_6502fff7:

    # mc "You know...this cupcake is pretty professionally made. How long have you been baking, Muramoto-san?"
    mc "Oye... este cupcake está muy bien hecho. ¿Cuánto tiempo llevas horneando, Muramoto-san?"

# game/story.rpy:3408
translate spanish story_1460343d:

    # n 5e "Long enough to know how to make good pastries."
    n 5e "Lo suficiente para saber hacer pasteles."

# game/story.rpy:3410
translate spanish story_d5ae2301_1:

    # mc "Fair enough."
    mc "Ya, bueno."

# game/story.rpy:3411
translate spanish story_894dc484:

    # "I finally bite down."
    "Por fin muerdo."

# game/story.rpy:3412
translate spanish story_a20cefa7_4:

    # "..."
    "..."

# game/story.rpy:3413
translate spanish story_3ba5b28b:

    # "Wow..."
    "Vaya..."

# game/story.rpy:3414
translate spanish story_12970445:

    # "The game did not do this justice by a long shot!"
    "¡El juego no hizo en absoluto justicia a esto!"

# game/story.rpy:3415
translate spanish story_02e6e362:

    # "The cupcake itself is light and fluffy, but not overly sweet like some are."
    "El cupcake en sí es ligero y esponjoso, pero no demasiado dulce como algunos."

# game/story.rpy:3416
translate spanish story_d8a743f5:

    # "The frosting, ugh I hate this cliché, but in this case, melting in my mouth {i}is{/i} a perfect description."
    "La crema... odio este cliché, pero en este caso, derretirse en la boca es una descripción perfecta."

# game/story.rpy:3417
translate spanish story_511bba33:

    # "The chocolate and vanilla flavors don't clash, but blend well with each other."
    "Los sabores a chocolate y vainilla no chocan, sino que se combinan bien entre sí."

# game/story.rpy:3418
translate spanish story_e4d5a2d3:

    # "Suddenly aware of how hungry I am, I devour it very quickly."
    "De repente, al darme cuenta de lo hambriento que estoy, me lo zampo muy rápido."

# game/story.rpy:3419
translate spanish story_efbf3831:

    # n 1p "Wha?! My cupcake! Be careful, dummy! Slow down!"
    n 1p "¡¿Qué?! ¡Mi cupcake! ¡Ten cuidado, tontuelo! ¡Más despacio!"

# game/story.rpy:3421
translate spanish story_12e8b185:

    # "I smile sheepishly as I place the paper wrapping down carefully."
    "Sonrío avergonzado mientras coloco el envoltorio de papel con cuidado."

# game/story.rpy:3422
translate spanish story_b608e44c:

    # mc "I haven't had much to eat today, only the broth that Mom left me this morning."
    mc "No he comido mucho hoy, solo el caldo que me dejó mamá esta mañana."

# game/story.rpy:3424
translate spanish story_3441b76d:

    # "I grab a napkin from a small stack that Sayori had brought in and wipe my mouth."
    "Cojo una servilleta de una pila pequeña que Sayori había traído y me limpio la boca."

# game/story.rpy:3425
translate spanish story_b6b917f1:

    # mc "Although I think one is enough for me for now. I hope it's okay if I take a few for later."
    mc "Aunque pienso que uno es suficiente para mí. Espero que no importe si me llevo unos para más tarde."

# game/story.rpy:3426
translate spanish story_fa669cf1:

    # n 5h "Do what you want, it's not like I...!"
    n 5h "Haz lo que quieras, no es que yo..."

# game/story.rpy:3427
translate spanish story_1a4729ae:

    # "I've {i}definitely{/i} heard this before."
    "Esto seguro que lo he oído antes."

# game/story.rpy:3429
translate spanish story_0b0590da:

    # n 5s "...Made them for you or anything."
    n 5s "... los hubiera hecho para ti o algo así."

# game/story.rpy:3430
translate spanish story_ca411d04:

    # cm "{i}You're right. She is a classic tsundere. That's some impressively weird logic she has there.{/i}"
    cm "{i}Tienes razón. Es una tsundere clásica. Tiene una lógica increíblemente rara.{/i}"

# game/story.rpy:3431
translate spanish story_833c83fc:

    # mc "{b}Told ya.{/b}"
    mc "{b}Te lo dije.{/b}"

# game/story.rpy:3432
translate spanish story_fdabab2b:

    # mc "I humbly accept these gracious offerings to my poor wounded stomach."
    mc "Acepto humildemente estas generosas ofrendas para mi pobre estómago herido."

# game/story.rpy:3433
translate spanish story_19da1c37:

    # "I take two more."
    "Tomo dos más."

# game/story.rpy:3436
translate spanish story_63850181:

    # "Yuri returns, carrying a tea set."
    "Yuri vuelve, llevando un juego de té."

# game/story.rpy:3438
translate spanish story_dbfcf1f1:

    # y "Here we are."
    y "He vuelto."

# game/story.rpy:3439
translate spanish story_8620062b:

    # y 1f "I'm surprised, though. This tea set is nearly identical to the one we keep in the club."
    y 1f "Aunque me sorprende. Este juego de té es casi idéntico al que guardamos en el club."

# game/story.rpy:3441
translate spanish story_e96f113a:

    # mc "It is?"
    mc "¿Ah, sí?"

# game/story.rpy:3442
translate spanish story_ec1e76f0:

    # y 2f "Yes, it's a bit older than the one in the club, but the design is almost identical."
    y 2f "Sí, es un poco más antiguo que el del club, pero el diseño es casi idéntico."

# game/story.rpy:3444
translate spanish story_b97d272b:

    # mc "Oh, that's quite a coincidence."
    mc "Anda, qué casualidad."

# game/story.rpy:3445
translate spanish story_3179a710:

    # y 1a "Ah, that is true."
    y 1a "Bueno."

# game/story.rpy:3447
translate spanish story_5c0bae0c:

    # mc "Hold up, you keep a whole tea set in the clubroom?"
    mc "Espera, ¿guardáis un juego de té entero en la sala de club?"

# game/story.rpy:3448
translate spanish story_47b339c0:

    # mc "How does that work?"
    mc "¿Cómo es eso?"

# game/story.rpy:3449
translate spanish story_3c6a6c97:

    # y 1a "Ah, yes. The teachers gave us permission to keep a set in the room."
    y 1a "Ah, los profesores nos dieron permiso para guardar un juego en la sala."

# game/story.rpy:3450
translate spanish story_8bcd63d2:

    # mc "Do you make tea regularly?"
    mc "¿Preparas té a menudo?"

# game/story.rpy:3451
translate spanish story_31eb0dba:

    # y 2a "I make it almost every day."
    y 2a "Casi todos los días."

# game/story.rpy:3452
translate spanish story_efc4ed34:

    # y "After all, doesn't a hot cup of tea help you enjoy a good book?"
    y "Bueno, ¿acaso no te ayuda una taza de té caliente a disfrutar de un buen libro?"

# game/story.rpy:3454
translate spanish story_de8b3252:

    # m "Ehehe, don't let yourself get intimidated, Yuri's just trying to impress you."
    m "Je, je, no te dejes intimidar, Yuri solo intenta impresionarte."

# game/story.rpy:3456
translate spanish story_1cca8d65:

    # mc "I'm not intimidated. I am impressed though."
    mc "No me siento intimidado. Impresionado, tal vez."

# game/story.rpy:3457
translate spanish story_218c9493:

    # "I give Yuri a kind smile."
    "Le doy a Yuri una sonrisa amable."

# game/story.rpy:3460
translate spanish story_d1e9e5c9:

    # y 3n "Eh?! T-That's not..."
    y 3n "¡¿Eh?! E-Eso no es..."

# game/story.rpy:3461
translate spanish story_911659b2:

    # "Yuri looks away, looking a bit insulted."
    "Yuri mira a otra parte, ligeramente ofendida."

# game/story.rpy:3462
translate spanish story_0403ff06:

    # y 4b "I meant that, you know..."
    y 4b "Lo he dicho en serio, ¿sabes...?"

# game/story.rpy:3463
translate spanish story_cda8d4f8:

    # mc "It's alright, Yoshika-san, I do enjoy a good cup of tea. And I'm sure my stomach could use it too."
    mc "No pasa nada, Yoshika-san, de verdad que disfruto de un buen té. Y estoy seguro de que mi estómago también lo agradecería."

# game/story.rpy:3465
translate spanish story_fb4dad3b:

    # y 2u "I'm glad..."
    y 2u "Me alegro..."

# game/story.rpy:3466
translate spanish story_72df4a29:

    # mc "Especially today."
    mc "Especialmente hoy."

# game/story.rpy:3467
translate spanish story_44c8a876:

    # m 1g "We're not bothering you too much, I hope?"
    m 1g "Perdona, espero que no estemos molestando."

# game/story.rpy:3468
translate spanish story_8aef3522:

    # mc "No, not at all. I'm feeling better than I did. If all goes well, I'll be at school tomorrow."
    mc "No, en absoluto. Me siento mejor de lo que estaba. Si todo va bien, estaré en el instituto mañana."

# game/story.rpy:3473
translate spanish story_20c65507:

    # "As Yuri begins pouring tea, Meiji speaks up."
    "Cuando Yuri empieza a servir el té, Meiji interviene."

# game/story.rpy:3474
translate spanish story_0b997a5f:

    # cm "{i}This isn't normal. Not normal at all. Four girls willingly coming over to a sick boy's house? Not normal.{/i}"
    cm "{i}Esto no es normal. Para nada normal. ¿Cuatro chicas viniendo voluntariamente a casa de un chico enfermo? No es normal.{/i}"

# game/story.rpy:3475
translate spanish story_1e86cedc:

    # cm "{i}I mean, I'm not surprised Sayori came over, but why these other girls? Not that I mind, but still...{/i}"
    cm "{i}O sea, no me sorprende que Sayori viniera, pero ¿por qué las otras chicas? No es que me importe, pero...{/i}"

# game/story.rpy:3476
translate spanish story_bb5f5c54:

    # mc "{b}No argument here. But then again, this is supposed to be a dating sim game.{/b}"
    mc "{b}Sin discusión aquí. Pero por otro lado, esto se supone que es un juego de citas.{/b}"

# game/story.rpy:3477
translate spanish story_339abc3a:

    # mc "{b}I wouldn't be surprised if their affection stats are higher than a normal human's.{/b}"
    mc "{b}No me sorprendería si sus estadísticas de afecto fueran más altas que las de un humano normal.{/b}"

# game/story.rpy:3478
translate spanish story_83cc2b4a:

    # mc "{b}Either that, or the script had to improvise.{/b}"
    mc "{b}Eso, o el guion tuvo que improvisar.{/b}"

# game/story.rpy:3479
translate spanish story_2d59a0b3:

    # "When Yuri's done pouring the tea, I take a cup, blow on it and sip. The taste isn't too strong and feels soothing as it flows down my throat."
    "Cuando Yuri termina de servir el té, cojo una taza, soplo sobre ella y doy un sorbo. El sabor no es demasiado fuerte y se siente reconfortante al bajar por la garganta."

# game/story.rpy:3481
translate spanish story_a12f47d3:

    # mc "Aaah...that really hits the spot. Thank you, Yoshika-san."
    mc "Ahhh... eso es lo que necesitaba. Gracias, Yoshika-san."

# game/story.rpy:3482
translate spanish story_3d436e8e:

    # y 3s "Ah, um, th-think nothing of it."
    y 3s "Ah, mmm, n-no es nada."

# game/story.rpy:3484
translate spanish story_1d794784:

    # m "Oh, by the way, there's no need to stand on ceremony with us."
    m "Ah, por cierto, no hace falta que andéis con ceremonias con nosotras."

# game/story.rpy:3485
translate spanish story_dd0e6ad1:

    # m "It's perfectly alright to call everyone by their first names."
    m "No hay ningún problema en que nos llaméis a todas por nuestro nombre."

# game/story.rpy:3489
translate spanish story_ece2e2fd:

    # n "Not mine!"
    n "¡Menos yo!"

# game/story.rpy:3492
translate spanish story_5dafe238:

    # m "Natsuki, don't be rude to a sick person."
    m "Natsuki, no seas descortés con una persona enferma."

# game/story.rpy:3494
translate spanish story_61f57c8d:

    # mc "It's fine, I'm flexible, Muramoto-san."
    mc "Vale, soy flexible, Muramoto-san."

# game/story.rpy:3497
translate spanish story_291c722f:

    # n 5s "Good..."
    n 5s "Bien..."

# game/story.rpy:3500
translate spanish story_6005f1d0:

    # mc "You all can call me by my first name too if you want."
    mc "También podéis llamarme a mí por mi nombre de pila, si queréis."

# game/story.rpy:3506
translate spanish story_c4c74790:

    # "Monika and Natsuki go to grab another cupcake, but Yuri looks at me curiously."
    "Monika y Natsuki van a coger otro cupcake, pero Yuri me mira con curiosidad."

# game/story.rpy:3507
translate spanish story_19dca5d5:

    # mc "Something on your mind, Yuri?"
    mc "¿Tienes algo en mente, Yuri?"

# game/story.rpy:3508
translate spanish story_28500060:

    # "I try not to sound rude."
    "Intento no sonar descortés."

# game/story.rpy:3509
translate spanish story_83ec3c65:

    # y 2t "Ah, my apologies. I was just, um, curious as to your literary interests."
    y 2t "Ah, disculpa. Es que... tengo curiosidad por tus intereses literarios."

# game/story.rpy:3510
translate spanish story_1ef2c5aa:

    # "She indicates the books on the table."
    "Indica los libros sobre la mesa."

# game/story.rpy:3511
translate spanish story_33365566:

    # y 2s "I assume you read manga?"
    y 2s "Supongo que lees mangas, ¿no?"

# game/story.rpy:3512
translate spanish story_6e00eeaa:

    # mc "For a long time, and I still do."
    mc "Desde hace mucho, y sigo haciéndolo."

# game/story.rpy:3514
translate spanish story_c6e48974:

    # "Natsuki's head suddenly perks up."
    "A Natsuki se le endereza la cabeza de repente."

# game/story.rpy:3515
translate spanish story_c517ca4b:

    # "Just like in the game, she looks like she wants to say something, but keeps quiet."
    "Como en el juego, parece que quiere decir algo, pero se calla."

# game/story.rpy:3519
translate spanish story_58609e7e:

    # mc "However, I've read a few other things as well."
    mc "Sin embargo, también he leído otras cosas."

# game/story.rpy:3520
translate spanish story_80d57784:

    # mc "Like I told Sayori recently, I read {i}Sense and Sensibility{/i} just for a change of pace."
    mc "Como le dije a Sayori recientemente, leí {i}Sensatez y sentimiento{/i} solo para cambiar de ritmo."

# game/story.rpy:3521
translate spanish story_b992b311:

    # mc "And then yesterday I picked up this book at the bookstore."
    mc "Y ayer cogí este libro en la librería."

# game/story.rpy:3522
translate spanish story_05e56bd6:

    # "I hold up {i}Portrait of Markov{/i}."
    "Levanto {i}El retrato de Markov{/i}."

# game/story.rpy:3523
translate spanish story_1639bb53:

    # mc "I've already read a bit into it. It's a good read so far."
    mc "Ya he leído un poco. Por ahora es una buena lectura."

# game/story.rpy:3524
translate spanish story_eb854369:

    # mc "I also read some of J. R. R. Tolkien's {i}Middle Earth{/i} fantasy books and I even read C.S. Lewis' {i}Chronicles of Narnia{/i} and his {i}Space Trilogy{/i}."
    mc "También he leído algunos de los libros de fantasía de J. R. R. Tolkien sobre la {i}Terra Media{/i} e incluso leí las {i}Crónicas de Narnia{/i} de C. S. Lewis y su {i}Trilogía Espacial{/i}."

# game/story.rpy:3525
translate spanish story_79e3eac7:

    # y 1b "W-Well, it's good you're trying to expand your horizons."
    y 1b "B-Bueno, está bien que estés intentando ampliar tus horizontes."

# game/story.rpy:3527
translate spanish story_09afb406:

    # mc "How about you?"
    mc "¿Y tú?"

# game/story.rpy:3528
translate spanish story_a89289a8:

    # y 1l "Well, let's see..."
    y 1l "Bueno, a ver..."

# game/story.rpy:3529
translate spanish story_de0357e1:

    # "Yuri traces the rim of her teacup with her finger."
    "Yuri recorre el borde de su taza de té con el dedo."

# game/story.rpy:3530
translate spanish story_17dec8ac:

    # y 1a "My favorites are usually novels that build deep and complex fantasy worlds."
    y 1a "Mis favoritas suelen ser novelas que construyen mundos de fantasía profundos y complejos."

# game/story.rpy:3531
translate spanish story_0f788588:

    # y "You mentioned Tolkien earlier. His books are long-time favorites of mine."
    y "Mencionaste a Tolkien antes. Sus libros son de mis favoritos desde hace tiempo."

# game/story.rpy:3532
translate spanish story_deb9aa56:

    # y "The level of creativity and craftsmanship he put into that world amazes me to no end."
    y "El nivel de creatividad y maestría que puso en ese mundo me maravilla sin más."

# game/story.rpy:3533
translate spanish story_2464ecd5:

    # y 1f "Same with other books with similar worldbuilding."
    y 1f "Igual con otros libros con una trama similar."

# game/story.rpy:3534
translate spanish story_5bec4238:

    # y "But what impressed me more about that book series is how he was able to tell such a human story within such a vast world."
    y "Pero lo que más me impresionó de esa serie de libros es cómo fue capaz de contar una historia tan humana dentro de un mundo tan vasto."

# game/story.rpy:3536
translate spanish story_919197d0:

    # mc "I agree. Even in manga, there can be complex worlds and incredible worldbuilding."
    mc "Estoy de acuerdo. Incluso en los mangas pueden existir mundos complejos y una trama que impresiona."

# game/story.rpy:3537
translate spanish story_909bed5c:

    # mc "I've even taken a stab at creating my own world, and I've come to respect those who do it a lot more."
    mc "Hasta me he atrevido a crear mi propio mundo, y ahora respeto mucho más a los que lo hacen."

# game/story.rpy:3538
translate spanish story_0bf97315:

    # mc "It takes a lot of intelligence and foresight."
    mc "Se necesita mucha inteligencia y previsión."

# game/story.rpy:3540
translate spanish story_403a1dc2:

    # "Yuri nods in agreement."
    "Yuri asiente en señal de acuerdo."

# game/story.rpy:3541
translate spanish story_830d7316:

    # y 2m "But you know, I like a lot of things."
    y 2m "Pero, ¿sabes?, me gustan un montón de cosas."

# game/story.rpy:3542
translate spanish story_7aa57972:

    # y "Stories with deep psychological elements usually immerse me as well."
    y "Las historias con elementos psicológicos profundos también me suelen sumergir."

# game/story.rpy:3543
translate spanish story_ac0029b1:

    # y 2a "It's pretty amazing how an author can take advantage of the readers' lack of imagination and throw them for a loop."
    y 2a "Es bastante impresionante cómo un autor puede aprovecharse de la falta de imaginación de los lectores y dejarlos desconcertados."

# game/story.rpy:3544
translate spanish story_c0fd2c73:

    # y "I've been reading a lot of horror lately. Coincidentally..."
    y "Últimamente he estado leyendo mucho horror. Casualmente..."

# game/story.rpy:3545
translate spanish story_fdcbb664:

    # "Yuri picks up {i}Portrait of Markov{/i}."
    "Yuri coge {i}El retrato de Markov{/i}."

# game/story.rpy:3546
translate spanish story_c5d24aa9:

    # y 2b "This one is one of my favorites."
    y 2b "Este es uno de mis favoritos."

# game/story.rpy:3548
translate spanish story_ed0c7fec:

    # mc "Well, don't spoil it for me."
    mc "Bueno, no me lo destripes."

# game/story.rpy:3549
translate spanish story_cdf83c93:

    # y 3c "Uhuhu, I won't."
    y 3c "Je, je, je, no lo haré."

# game/story.rpy:3550
translate spanish story_42ff69f8:

    # y 2b "Firsthand experience of a book without knowing the plot is always the best."
    y 2b "Vivir un libro en primera persona, sin conocer la trama, es siempre lo mejor."

# game/story.rpy:3553
translate spanish story_e4fe1a6b:

    # m "Horror? I didn't expect that from you, Yuri."
    m "¿Horror? No me lo esperaba de ti, Yuri."

# game/story.rpy:3554
translate spanish story_0eec58f2:

    # m "Especially for someone as gentle and caring as you..."
    m "Especialmente de alguien tan gentil y cariñoso como tú..."

# game/story.rpy:3557
translate spanish story_84a13e28:

    # y 1a "I guess you could say that."
    y 1a "Tal vez tengas razón."

# game/story.rpy:3558
translate spanish story_38b0ae71:

    # y "But if a story makes me think, or takes me to another world, then I really can't put it down."
    y "Pero si una historia me hace pensar, o me lleva a otro mundo, entonces de verdad no puedo soltarla."

# game/story.rpy:3559
translate spanish story_fa55ff2a:

    # y "Surreal horror is often very successful at changing the way you look at the world, if only for a brief moment."
    y "El horror surrealista a menudo es muy eficaz cambiando la forma en que ves el mundo, aunque sea por un breve momento."

# game/story.rpy:3561
translate spanish story_b3281357:

    # mc "As opposed to physical horror? I mean that makes sense. Those types rely on cheap scares."
    mc "¿En contraposición al horror físico? O sea, eso tiene sentido. Ese tipo de horror se basa en sustos baratos."

# game/story.rpy:3563
translate spanish story_86c12410:

    # y "Exactly."
    y "Exactamente."

# game/story.rpy:3566
translate spanish story_b8c3c144:

    # n "Ugh, I hate horror..."
    n "Arg, odio el horror..."

# game/story.rpy:3569
translate spanish story_ff8cea96:

    # y 2f "Oh? Why's that?"
    y 2f "Ah, ¿por qué?"

# game/story.rpy:3572
translate spanish story_ab1562c5:

    # n 5c "Well, I just..."
    n 5c "Bueno, es que..."

# game/story.rpy:3574
translate spanish story_ec2ec14e:

    # "Natsuki's eyes dart over to me for a split second. Almost as if she's asking for backup."
    "Los ojos de Natsuki se me clavan un instante. Como si pidiera refuerzos."

# game/story.rpy:3575
translate spanish story_be619858:

    # mc "I get where you're coming from, Muramoto-san."
    mc "Te entiendo, Muramoto-san."

# game/story.rpy:3576
translate spanish story_1c8434e9:

    # mc "I have a love-hate relationship with horror."
    mc "Tengo una relación de amor-odio con el horror."

# game/story.rpy:3577
translate spanish story_d34ffecd:

    # mc "Anytime I watch anything related to horror, I have to sleep with the covers over my head for fear of the monsters I know are not there."
    mc "Cada vez que veo algo relacionado con el horror, tengo que dormir con la manta sobre la cabeza por miedo a los monstruos que sé que no están ahí."

# game/story.rpy:3578
translate spanish story_81250fef:

    # mc "Mind and emotions are two different aspects of the human psyche."
    mc "La mente y las emociones son dos aspectos diferentes de la psique humana."

# game/story.rpy:3579
translate spanish story_c5900668:

    # mc "We can know that ghosts and monsters don't exist, but our emotions tell us otherwise."
    mc "Puedemos saber que los fantasmas y los monstruos no existen, pero nuestras emociones nos dicen lo contrario."

# game/story.rpy:3580
translate spanish story_9d62082e:

    # mc "Even then, I still find myself drawn to horror when the mood strikes me."
    mc "Aun así, me siento atraído por el horror cuando me da la vena."

# game/story.rpy:3582
translate spanish story_3219f135:

    # n 5e "Exactly!"
    n 5e "¡Exacto!"

# game/story.rpy:3583
translate spanish story_1926d83a:

    # n 5s "Well, except for the acting like a kid part and hiding under the covers."
    n 5s "Bueno, excepto por la parte de actuar como un niño y esconderse bajo las mantas."

# game/story.rpy:3586
translate spanish story_4f9490ea:

    # m 2b "That's right, you usually like to write about cute things, don't you, Natsuki?"
    m 2b "Así es, a ti normalmente te gusta escribir sobre cosas monas, ¿no, Natsuki?"

# game/story.rpy:3589
translate spanish story_3df32e44:

    # n "What gives you that idea?"
    n "¿Y de dónde sacas esa idea?"

# game/story.rpy:3592
translate spanish story_550dd777:

    # m 3b "You left a piece of scrap paper behind last club meeting."
    m 3b "Dejaste un borrador en la última reunión del club..."

# game/story.rpy:3594
translate spanish story_3e6f31c3:

    # "Monika reaches into her blazer pocket and pulls out a scrap of paper."
    "Monika mete la mano en el bolsillo de su chaqueta y saca un papelito."

# game/story.rpy:3595
translate spanish story_d30c5826:

    # "Wait...she isn't going to say anything about the title?"
    "Espera... ¿no va a decir nada sobre el título?"

# game/story.rpy:3597
translate spanish story_b66f0cbd:

    # n "Who gave you permission to look at it?!"
    n "¡¿Quién te dio permiso para mirar?!"

# game/story.rpy:3600
translate spanish story_df169252:

    # m 1j "I had to find out who it belonged to~"
    m 1j "¡Tenía que saber a quién pertenecía...!"

# game/story.rpy:3607
translate spanish story_fa944ba0:

    # s "Ehehe, your cupcakes, your poems..."
    s "Je, je, tus cupcakes, tus poemas..."

# game/story.rpy:3608
translate spanish story_6ca73954:

    # s "They all scream cute! Just like you!"
    s "¡Todos gritan mono! ¡Igual que tú!"

# game/story.rpy:3610
translate spanish story_d7e5e754:

    # "Sayori slides up behind Natsuki and puts her hands on her shoulders."
    "Sayori se cuela detrás de Natsuki y le pone las manos en los hombros."

# game/story.rpy:3612
translate spanish story_6ccf1bfd:

    # n 1v "{i}I'm not cute!!{/i}"
    n 1v "¡No soy mona!!"

# game/story.rpy:3614
translate spanish story_547a3fa0:

    # mc "Sayori, cut Muramoto-san some slack."
    mc "Sayori, no le exijas tanto a Muramoto-san."

# game/story.rpy:3616
translate spanish story_89e08697:

    # s "Eh?"
    s "¿Eh?"

# game/story.rpy:3617
translate spanish story_4420f9f0:

    # mc "There are a lot of people who think being called cute means they're not being taken seriously."
    mc "Hay mucha gente que cree que si les llaman monos, no les toman en serio."

# game/story.rpy:3618
translate spanish story_a877f8ca:

    # "I ruffle Sayori's hair playfully."
    "Le revuelvo el cabello a Sayori con un gesto juguetón."

# game/story.rpy:3619
translate spanish story_46ae5c76:

    # s 1f "I'm sorry, Natsuki, I didn't know..."
    s 1f "Perdona, Natsuki, no sabía..."

# game/story.rpy:3620
translate spanish story_d4a68851:

    # n 5w "Forget it, it's fine."
    n 5w "Olvidalo, no pasa nada."

# game/story.rpy:3624
translate spanish story_82a7e721:

    # mc "Muramoto-san, you write your own poems?"
    mc "Muramoto-san, ¿escribes tus propios poemas?"

# game/story.rpy:3625
translate spanish story_8741dd49:

    # n 1c "Eh?"
    n 1c "¿Eh?"

# game/story.rpy:3627
translate spanish story_8d1ee062:

    # "The question seems to disarm her a bit."
    "La pregunta parece desarmarla un poco."

# game/story.rpy:3628
translate spanish story_b3b09ebd:

    # n 1c "Well, I guess sometimes."
    n 1c "Bueno, a veces."

# game/story.rpy:3629
translate spanish story_842dce39:

    # n "Why do you care?"
    n "¿Por qué te importa?"

# game/story.rpy:3631
translate spanish story_44b0836d:

    # mc "I just ask because I do on occasion. It's quite an interesting change of pace."
    mc "Solo pregunto porque de vez en cuando también escribo. Es un cambio de ritmo bastante interesante."

# game/story.rpy:3632
translate spanish story_fe236edf:

    # mc "I don't have many poems, but what I do have I'd gladly share with the club for critiquing."
    mc "No tengo muchos poemas, pero los que tengo los compartiría encantado con el club para que los lean."

# game/story.rpy:3633
translate spanish story_dab06c30:

    # mc "I'd also like to see yours, if I can."
    mc "También me gustaría ver los tuyos, si puedo."

# game/story.rpy:3634
translate spanish story_3f199bd2:

    # n 5q "N-No!"
    n 5q "¡N-No!"

# game/story.rpy:3636
translate spanish story_07d1f3e3:

    # "Color comes to her cheeks."
    "El rubor le sube a las mejillas."

# game/story.rpy:3637
translate spanish story_f10698b2:

    # mc "Really? How come?"
    mc "¿En serio? ¿Por qué?"

# game/story.rpy:3639
translate spanish story_9d7b9bad:

    # n "You wouldn't...like them..."
    n "No te van a... gustar..."

# game/story.rpy:3640
translate spanish story_38a9a094:

    # mc "You sound so certain. How do you know what I do and don't like?"
    mc "Suenas muy segura. ¿Cómo sabes qué me gusta y qué no?"

# game/story.rpy:3641
translate spanish story_f11b1658:

    # "I pick up both {i}Parfait Girls{/i} and {i}Portrait of Markov{/i}."
    "Cojo tanto {i}Parfait Girls{/i} como {i}El retrato de Markov{/i}."

# game/story.rpy:3643
translate spanish story_7ed5c7be:

    # mc "If I can be reading both of these and enjoying them equally, what makes you think I won't enjoy your poems?"
    mc "Si puedo leer ambos y disfrutarlos por igual, ¿por qué crees que no me gustarán tus poemas?"

# game/story.rpy:3646
translate spanish story_7e67e889:

    # y "I understand how Natsuki feels."
    y "Entiendo cómo se siente Natsuki."

# game/story.rpy:3647
translate spanish story_a387c89f:

    # y "Sharing that level of writing takes more than just confidence."
    y "Compartir ese nivel de escritura requiere más que simplemente confianza."

# game/story.rpy:3648
translate spanish story_e06ca773:

    # y 2k "The truest form of writing is writing to oneself."
    y 2k "La forma más auténtica de escribir es escribir para uno mismo."

# game/story.rpy:3649
translate spanish story_d2b7c428:

    # y "You must be willing to open up to your readers, exposing your vulnerabilities and showing even the deepest reaches of your heart."
    y "Hay que estar dispuesto a abrirse a los lectores, exponiendo tus vulnerabilidades y mostrando hasta los rincones más profundos de tu corazón."

# game/story.rpy:3653
translate spanish story_d526bbf0:

    # m "Do you have writing experience too, Yuri?"
    m "¿Tú también tienes experiencia escribiendo, Yuri?"

# game/story.rpy:3654
translate spanish story_2bc6a16e:

    # m "Maybe if you share some of your work, you can set an example and help Natsuki feel comfortable enough to share hers."
    m "Quizás si compartes algo de tu trabajo, puedes dar el ejemplo y ayudar a Natsuki a sentirse lo suficientemente cómoda para compartir el suyo."

# game/story.rpy:3656
translate spanish story_5a6499dc:

    # y 3o "..."
    y 3o "..."

# game/story.rpy:3658
translate spanish story_8acd6c47:

    # s "Aww... I wanted to read everyone's poems too..."
    s "Eyyy... yo también quiero leer los poemas de todos..."

# game/story.rpy:3665
translate spanish story_7d1fff48:

    # "After a few seconds of silence, I clear my throat."
    "Tras unos segundos de silencio, me aclaro la garganta."

# game/story.rpy:3666
translate spanish story_727577ce:

    # "Turning to Monika, I hold up my hand in imitation of the gesture Monika would make in the game."
    "Girándome hacia Monika, levanto la mano imitando el gesto que haría Monika en el juego."

# game/story.rpy:3668
translate spanish story_4c4cac0b:

    # mc "Okay, Monika. I have an idea I want to run past you."
    mc "Vale, Monika. Tengo una idea que quiero comentarte."

# game/story.rpy:3669
translate spanish story_2a7a6d5e:

    # m 4y "I think we're thinking the same thing."
    m 4y "Creo que estamos pensando lo mismo."

# game/story.rpy:3670
translate spanish story_fa5a3de7:

    # mc "I don't doubt it."
    mc "No lo dudo."

# game/story.rpy:3671
translate spanish story_99686361:

    # cm "{i}Oh, why don't you two just make out already? It's obvious you like her!{/i}"
    cm "{i}Eh, ¿por qué no os buscáis un motel? ¡Es obvio que te gusta!{/i}"

# game/story.rpy:3672
translate spanish story_d81b03c8:

    # mc "{b}You really want me to kiss her while I'm still in your body?{/b}"
    mc "{b}¿De verdad quieres que lo haga mientras siga en tu cuerpo?{/b}"

# game/story.rpy:3673
translate spanish story_f29b72f1:

    # cm "{i}Huh?! NO!{/i}"
    cm "{i}¡¿Eh?! ¡NO!{/i}"

# game/story.rpy:3674
translate spanish story_0e03a668:

    # mc "{b}Well there you go.{/b}"
    mc "{b}Entonces calla.{/b}"

# game/story.rpy:3676
translate spanish story_2ffc1dd9:

    # m "I have an idea, everyone~"
    m "¡Tengo una idea!"

# game/story.rpy:3679
translate spanish story_95cd0d51:

    # ny "...?"
    ny "¿...?"

# game/story.rpy:3680
translate spanish story_d080e0ca:

    # "Natsuki and Yuri look quizzically at Monika."
    "Natsuki y Yuri miran a Monika con cara de interrogante."

# game/story.rpy:3681
translate spanish story_a4f63044:

    # m 2b "Let's all go home and write a poem of our own!"
    m 2b "¡Vamos todos a casa y a escribir un poema!"

# game/story.rpy:3682
translate spanish story_cd1a6280:

    # m "Then, next time we meet, we'll all share them with each other."
    m "Entonces, la próxima vez que nos veamos, los compartiremos entre todos."

# game/story.rpy:3683
translate spanish story_a106107a:

    # m "That way, everyone is even!"
    m "¡Así, todos estaremos a un mismo nivel!"

# game/story.rpy:3686
translate spanish story_963b3971:

    # n 5q "U-Um..."
    n 5q "Ehhh..."

# game/story.rpy:3689
translate spanish story_71a86863:

    # y "..."
    y "..."

# game/story.rpy:3694
translate spanish story_6766811d:

    # s "Yeaaah! Let's do it!"
    s "¡Siiií! ¡Hagámoslo!"

# game/story.rpy:3697
translate spanish story_cdd2d381:

    # m 1a "Plus, now that we have a new member, I think it will help us all get a little more comfortable with each other, and strengthen the bond of the club."
    m 1a "Además, ahora que tenemos una nueva miembro, creo que nos ayudará a todos a sentirnos un poco más cómodos entre nosotros y fortalecer el vínculo del club."

# game/story.rpy:3698
translate spanish story_87e7c040:

    # m 1zb "Isn't that right, {i}Meiji{/i}?"
    m 1zb "¿Verdad, {i}Meiji{/i}?"

# game/story.rpy:3700
translate spanish story_2809cb4f:

    # "Monika gives me a knowing look."
    "Monika me lanza una mirada cómplice."

# game/story.rpy:3701
translate spanish story_4a96688c:

    # "She's being as subtle as a brick through a window."
    "Es tan sutil como un ladrillo a través de una ventana."

# game/story.rpy:3702
translate spanish story_2d99d21d:

    # mc "Well, considering I never said-"
    mc "Bueno, considerando que nunca dije..."

# game/story.rpy:3706
translate spanish story_a7426541:

    # "I freeze. All the girls are looking at me expectantly."
    "Me quedo helado. Todas las chicas me miran con expectación."

# game/story.rpy:3707
translate spanish story_db149405:

    # mc "You know what, that is a good idea. And I'd love to contribute..."
    mc "Oye, esa es una buena idea. Y me encantaría contribuir..."

# game/story.rpy:3708
translate spanish story_7128d219:

    # mc "...as your newest member."
    mc "... como vuestro miembro nuevo."

# game/story.rpy:3712
translate spanish story_a9fad41d:

    # "Their eyes light up. Even Natsuki's."
    "Sus ojos se iluminan. Incluso los de Natsuki."

# game/story.rpy:3714
translate spanish story_884cf4a1:

    # s 4r "Really?! Yesss! I'm so happyyy~"
    s 4r "¡¿De verdad?! ¡Siiií! ¡Estoy tan feliizz...!"

# game/story.rpy:3716
translate spanish story_4037de6b:

    # "Sayori wraps her arms around me, jumping up and down."
    "Sayori me abraza, saltando de arriba abajo."

# game/story.rpy:3717
translate spanish story_9cd1e1db:

    # mc "H-Hey--Sayori...gonna puke...tap out, tap out!"
    mc "¡Eyyy Sayori... voy a vomitar... me rindo, me rindo!"

# game/story.rpy:3719
translate spanish story_6d4ee33d:

    # s 5b "Ehehe, sorry!"
    s 5b "¡Je, je, perdona!"

# game/story.rpy:3722
translate spanish story_d971fa05:

    # n "You're not just joining for the cupcakes, right?"
    n "No te unes solo por los cupcakes, ¿verdad?"

# game/story.rpy:3724
translate spanish story_0b1479e0:

    # mc "Not at all. They're a good selling point, I'll give you that, but I do want to try something new. Sayori seems to enjoy this club, after all."
    mc "En absoluto. Son un buen aliciente, te lo concedo, pero de verdad que quiero probar algo nuevo. Sayori disfruta de este club, después de todo."

# game/story.rpy:3726
translate spanish story_8fc8269b:

    # m "Then let's make it official."
    m "Entonces hagámoslo oficial."

# game/story.rpy:3727
translate spanish story_7d3a43d8:

    # m 10b "Welcome to the Literature Club!"
    m 10b "¡Bienvenido al Club de Literatura!"

# game/story.rpy:3729
translate spanish story_4cbe89e4:

    # "Huh?"
    "¿Eh?"

# game/story.rpy:3730
translate spanish story_77342c77:

    # "Is Monika left handed?"
    "¿Monika es zurda?"

# game/story.rpy:3731
translate spanish story_e04d6316:

    # "No, there's a piece of paper in her hand."
    "No, hay un papel en su mano."

# game/story.rpy:3732
translate spanish story_bf82e136:

    # "I take her hand and shake it."
    "Le tomo la mano y la estrecho."

# game/story.rpy:3734
translate spanish story_c3a3bb4f:

    # "The paper is slipped into my hand."
    "Me mete el papel en la mano."

# game/story.rpy:3735
translate spanish story_0f52a101:

    # mc "Thank you, Madame President."
    mc "Gracias, Madame President."

# game/story.rpy:3743
translate spanish story_2526ccea:

    # "As we release hands, Monika asks me something new."
    "Al soltar las manos, Monika me pregunta algo nuevo."

# game/story.rpy:3744
translate spanish story_f5929d21:

    # m 1d "Hey, Meiji?"
    m 1d "Oye, Meiji?"

# game/story.rpy:3745
translate spanish story_f49fff8f_1:

    # mc "Yeah?"
    mc "¿Sí?"

# game/story.rpy:3746
translate spanish story_690ad8c2:

    # m 2c "Sayori mentioned while we were coming here that you've read {i}Sense and Sensibility{/i}?"
    m 2c "Sayori mencionó mientras veníamos que has leído {i}Sensatez y sentimiento{/i}, ¿no?"

# game/story.rpy:3747
translate spanish story_9c8e7586:

    # m "And you confirmed it earlier."
    m "Y tú lo confirmaste antes."

# game/story.rpy:3748
translate spanish story_09722dcb:

    # "I raise an eyebrow."
    "Levanto una ceja."

# game/story.rpy:3749
translate spanish story_479df990:

    # mc "Yeah I have...why?"
    mc "Sí... ¿por qué?"

# game/story.rpy:3750
translate spanish story_2b6e9876:

    # m 6d "I was just wondering if I could ask your opinion on something?"
    m 6d "Solo quería saber si podía pedirte tu opinión sobre algo."

# game/story.rpy:3751
translate spanish story_2780ba84:

    # m "Is that okay?"
    m "¿Está bien?"

# game/story.rpy:3753
translate spanish story_fdc6f57f:

    # mc "{b}This...wasn't something that was part of the game.{/b}"
    mc "{b}Esto... no era algo que formara parte del juego.{/b}"

# game/story.rpy:3754
translate spanish story_e9cd20ef:

    # cm "{i}See? You're already changing things!{/i}"
    cm "{i}¿Ves? ¡Ya estás cambiando las cosas!{/i}"

# game/story.rpy:3755
translate spanish story_5f94e727:

    # mc "It's been a while since I've read the book, but sure, I can try."
    mc "Llevo un tiempo sin leer el libro, pero vale, puedo intentarlo."

# game/story.rpy:3756
translate spanish story_294bf04a:

    # m 4zi "Ahaha, well it's just about Edward keeping his engagement a secret from Elinor. Was he right?"
    m 4zi "Ja, ja, ja, bueno, es sobre cómo Edward mantiene su compromiso en secreto sin decírselo a Elinor. ¿Estaba en lo cierto?"

# game/story.rpy:3759
translate spanish story_afb3b8d1:

    # n "I still say he should have told Elinor!"
    n "¡Sigo diciendo que debería haberlo contado a Elinor!"

# game/story.rpy:3763
translate spanish story_9609f3a3:

    # y "N-Natsuki, I keep telling you, he was an honorable man."
    y "N-Natsuki, no dejo de decírtelo, era un hombre honorable."

# game/story.rpy:3764
translate spanish story_2d8ac1ee:

    # y "He didn't want to dishonor his family name."
    y "No quería deshonrar el nombre de su familia."

# game/story.rpy:3769
translate spanish story_7199d1c1:

    # s "You guys..."
    s "Vosotros..."

# game/story.rpy:3771
translate spanish story_4d211a5d:

    # "As I see this, I get the distinct impression that Monika isn't just asking about the book. It might be that she wants my opinion on secrets."
    "Al ver esto, tengo la clara impresión de que Monika no pregunta solo por el libro. Puede que quiera mi opinión sobre los secretos."

# game/story.rpy:3772
translate spanish story_3b1a01fc:

    # "Like the one she's keeping from her clubmates."
    "Como el que le está guardando a sus compañeras de club."

# game/story.rpy:3777
translate spanish story_e1d32b04:

    # mc "Well, it's a tough question to answer, if I'm honest."
    mc "Bueno, es una pregunta difícil de responder, si te soy sincero."

# game/story.rpy:3778
translate spanish story_9386767a:

    # mc "On the one hand Yuri, you're right. He was honor-bound to his engagement to Lucy."
    mc "Por un lado, Yuri, tienes razón. Estaba ligado por honor a su compromiso con Lucy."

# game/story.rpy:3779
translate spanish story_21daa24d:

    # mc "But you're also right, Muramoto-san. He probably should have told Elinor, but remember that he isn't perfect."
    mc "Pero tú también tienes razón, Muramoto-san. Probablemente debería habérselo dicho a Elinor, pero recuerda que no es perfecto."

# game/story.rpy:3780
translate spanish story_2e1fd50a:

    # mc "Edward was pretty shy and didn't really pursue Elinor that much in the beginning."
    mc "Edward era bastante tímido y no la corteó demasiado al principio."

# game/story.rpy:3781
translate spanish story_f6459c41:

    # mc "It's the imperfections of the characters that make them all so intriguing."
    mc "Son las imperfecciones de los personajes las que los hacen tan intrigantes."

# game/story.rpy:3782
translate spanish story_60692a15:

    # mc "I mean, I wouldn't enjoy a manga or light novel so much if the main character was completely OP."
    mc "O sea, no disfrutaría tanto de un manga o novela ligera si el protagonista fuera completamente un dios."

# game/story.rpy:3783
translate spanish story_7eef3f55:

    # mc "Unless it's done in an interesting and unique way."
    mc "A menos que se haga de una forma interesante y única."

# game/story.rpy:3787
translate spanish story_0a63c421:

    # "I finish and notice all the girls are looking at me, but especially Sayori who looks completely dumbstruck."
    "Termino y noto que todas las chicas me miran, pero especialmente Sayori, que parece completamente atónita."

# game/story.rpy:3788
translate spanish story_b5548892:

    # mc "Ah, sorry, I didn't mean to go on a tangent."
    mc "Ah, perdón, no quería irme por las nubes."

# game/story.rpy:3790
translate spanish story_ff64b9bc:

    # m "No, it's okay, thanks for your opinion."
    m "No, no pasa nada, gracias por tu opinión."

# game/story.rpy:3794
translate spanish story_f35aaeda:

    # n 5i "Hmm...I guess when you put it that way...it kind of makes sense."
    n 5i "Mmm... supongo que, visto así... tiene cierto sentido."

# game/story.rpy:3795
translate spanish story_76a966c0:

    # n 5h "But he still should have said something!"
    n 5h "¡Pero aun así debería haber dicho algo!"

# game/story.rpy:3797
translate spanish story_0d688610:

    # mc "It's a slippery slope either way."
    mc "Es un terreno resbaladizo, por donde se mire."

# game/story.rpy:3799
translate spanish story_0ba2fa43:

    # y 3u "Y-Yes it is."
    y 3u "S-Sí, lo es."

# game/story.rpy:3802
translate spanish story_4968a42a:

    # s 4x "But at least they ended up together in the end, right?"
    s 4x "Pero al menos al final terminaron juntos, ¿no?"

# game/story.rpy:3804
translate spanish story_d991d370:

    # mc "Heh, yes, there is that."
    mc "Je, sí, eso también."

# game/story.rpy:3813
translate spanish story_e719ebca:

    # m 3b "Okay, everyone!"
    m 3b "¡Vale, compis!"

# game/story.rpy:3814
translate spanish story_94216935:

    # m "I think with that, we can officially end today's somewhat unusual meeting on a good note."
    m "Creo que con eso podemos cerrar oficialmente la reunión de hoy, algo inusual, con buen sabor de boca."

# game/story.rpy:3815
translate spanish story_435b8f44:

    # m "Everyone remember tonight's assignment:"
    m "Recordad todos la tarea de esta noche:"

# game/story.rpy:3816
translate spanish story_f3222edc:

    # m "Write a poem to bring to the next meeting, so we can all share!"
    m "¡Escribir un poema para traer a la próxima reunión, así todos podemos compartirlo!"

# game/story.rpy:3818
translate spanish story_14566f4e:

    # "Monika looks over at me."
    "Monika me mira."

# game/story.rpy:3819
translate spanish story_8d2da033:

    # m 6j "Meiji, I really, {i}really{/i} look forward to seeing how you express yourself."
    m 6j "Meiji, de verdad que no puedo esperar a ver cómo te expresas."

# game/story.rpy:3820
translate spanish story_131cae6e:

    # m 6l "And get better soon."
    m 6l "Y cúrate pronto."

# game/story.rpy:3821
translate spanish story_430fe3aa:

    # "I grin and salute."
    "Suelto una sonrisa y saludo."

# game/story.rpy:3822
translate spanish story_95a4c8fa:

    # mc "Will do, Madame President!"
    mc "¡A sus ordenes, Madame President!"

# game/story.rpy:3823
translate spanish story_e94fd41a:

    # "I begin to clean up."
    "Empiezo a recoger."

# game/story.rpy:3824
translate spanish story_39549f06:

    # m 4b "Oh, let us do that."
    m 4b "Ah, déjanos ayudar."

# game/story.rpy:3826
translate spanish story_149b899f:

    # "She grabs the tray I'm about to take, and our hands touch."
    "Coge la bandeja que estaba a punto de tomar y nuestras manos se tocan."

# game/story.rpy:3828
translate spanish story_a2c5302e:

    # "Her hand lingers longer than necessary."
    "Su mano se queda más tiempo del necesario."

# game/story.rpy:3829
translate spanish story_d121e1e9:

    # mc "You've already done more than enough for us-I mean me."
    mc "Ya has hecho más que suficiente por nosotros... quiero decir, por mí."

# game/story.rpy:3830
translate spanish story_c89af905:

    # "I purposely use a plural and act as if I've made a mistake."
    "Uso un plural a propósito y actúo como si hubiera cometido un error."

# game/story.rpy:3831
translate spanish story_a545c8d9:

    # mc "Let me at least do something-"
    mc "Al menos déjame hacer algo..."

