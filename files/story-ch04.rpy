    # mc "I don't know how to broach the subject of you and me without hurting Sayori."
    mc "No sé cómo plantear el tema de los dos sin herir a Sayori."

# game/story.rpy:4229
translate spanish story_3c6aabf4:

    # mc "I hate not knowing what to do."
    mc "Odio no saber qué hacer."

# game/story.rpy:4230
